isable() on this track to prevent it from being played. If the track","type":"text"},{"text":" ","type":"text"},{"text":"was previously disabled, the application must call enable() for the track","type":"text"},{"text":" ","type":"text"},{"text":"to be renderable. If the track was previously enabled by the application and is not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"disabled by the application it will automatically start playing once it becomes"},{"type":"text","text":" "},{"type":"text","text":"active."}]},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrack/activity()":{"type":"topic","abstract":[{"text":"Create an AsyncStream to receive track activity events","type":"text"}],"title":"activity()","kind":"symbol","role":"symbol","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrack\/activity()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"activity","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"ActivityEvent","preciseIdentifier":"s:So16MCRTSRemoteTrackC12MillicastSDKE13ActivityEventO","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/millicastsdk\/mcrtsremotetrack\/activity()"},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK":{"title":"MillicastSDK","role":"collection","url":"\/documentation\/millicastsdk","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK"},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrackDelegate/rtsRemoteTrackInactive(_:)":{"type":"topic","navigatorTitle":[{"text":"rtsRemoteTrackInactive:","kind":"identifier"}],"title":"rtsRemoteTrackInactive(_:)","role":"symbol","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrackDelegate\/rtsRemoteTrackInactive(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rtsRemoteTrackInactive","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MCRTSRemoteTrack","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)MCRTSRemoteTrack"},{"text":")","kind":"text"}],"kind":"symbol","url":"\/documentation\/millicastsdk\/mcrtsremotetrackdelegate\/rtsremotetrackinactive(_:)","abstract":[{"type":"text","text":"Event received when the track, i.e. it’s publishing source, has become inactive."},{"text":" ","type":"text"},{"text":"In other words the publishers stream is no longer being sent to the server and is","type":"text"},{"text":" ","type":"text"},{"text":"thus no longer viewable on the viewing client. The track is not disabled by the SDK","type":"text"},{"text":" ","type":"text"},{"text":"when this event occurs. If the application wants to ensure the track will not","type":"text"},{"text":" ","type":"text"},{"text":"automatically be played once the source becomes active it should call disable() when","type":"text"},{"text":" ","type":"text"},{"text":"receiving this event. Then it is responsible for calling enable() on the Active event.","type":"text"},{"text":" ","type":"text"},{"text":"If the application does not disable on Inactive event, the track will automatically start","type":"text"},{"text":" ","type":"text"},{"text":"playing when the remote source becomes Active.","type":"text"}]},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrack":{"identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrack","type":"topic","url":"\/documentation\/millicastsdk\/mcrtsremotetrack","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MCRTSRemoteTrack"}],"navigatorTitle":[{"kind":"identifier","text":"MCRTSRemoteTrack"}],"abstract":[{"text":"The RTS logical track.","type":"text"},{"text":" ","type":"text"},{"text":"This class represents a single media (audio or video) in the RTS stream.","type":"text"},{"text":" ","type":"text"},{"text":"The RTS tracks are created automatically when the service notifies about the","type":"text"},{"text":" ","type":"text"},{"text":"sources becoming active, can be used to enable simple streaming scenarios:","type":"text"},{"text":" ","type":"text"},{"text":"enable projection of the audio and video coming from the same source with","type":"text"},{"text":" ","type":"text"},{"text":"lip-sync, with a single video renderer attached to the video track. When the","type":"text"},{"text":" ","type":"text"},{"text":"RTS source goes inactive, streaming for them is automatically disabled.","type":"text"}],"kind":"symbol","title":"MCRTSRemoteTrack"},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrack/ActivityEvent":{"type":"topic","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrack\/ActivityEvent","navigatorTitle":[{"text":"ActivityEvent","kind":"identifier"}],"abstract":[{"text":"Track activity event","type":"text"}],"title":"MCRTSRemoteTrack.ActivityEvent","url":"\/documentation\/millicastsdk\/mcrtsremotetrack\/activityevent","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityEvent","kind":"identifier"}],"role":"symbol"}},"variantOverrides":[{"patch":[{"value":"rtsRemoteTrackActive:","path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrackDelegate~1rtsRemoteTrackActive(_:)\/title","op":"replace"},{"value":[{"text":"- ","kind":"text"},{"text":"rtsRemoteTrackActive:","kind":"identifier"}],"path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrackDelegate~1rtsRemoteTrackActive(_:)\/fragments","op":"replace"},{"value":"rtsRemoteTrackInactive:","path":"\/references\/doc:~1~1io.cosmosoftware.