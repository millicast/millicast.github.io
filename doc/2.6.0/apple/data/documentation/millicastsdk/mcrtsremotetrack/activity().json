rack":{"identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrack","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MCRTSRemoteTrack"}],"title":"MCRTSRemoteTrack","kind":"symbol","abstract":[{"text":"The RTS logical track.","type":"text"},{"text":" ","type":"text"},{"text":"This class represents a single media (audio or video) in the RTS stream.","type":"text"},{"text":" ","type":"text"},{"text":"The RTS tracks are created automatically when the service notifies about the","type":"text"},{"text":" ","type":"text"},{"text":"sources becoming active, can be used to enable simple streaming scenarios:","type":"text"},{"text":" ","type":"text"},{"text":"enable projection of the audio and video coming from the same source with","type":"text"},{"text":" ","type":"text"},{"text":"lip-sync, with a single video renderer attached to the video track. When the","type":"text"},{"text":" ","type":"text"},{"text":"RTS source goes inactive, streaming for them is automatically disabled.","type":"text"}],"url":"\/documentation\/millicastsdk\/mcrtsremotetrack","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MCRTSRemoteTrack"}]},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrackDelegate/rtsRemoteTrackActive(_:)":{"title":"rtsRemoteTrackActive(_:)","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrackDelegate\/rtsRemoteTrackActive(_:)","navigatorTitle":[{"text":"rtsRemoteTrackActive:","kind":"identifier"}],"role":"symbol","url":"\/documentation\/millicastsdk\/mcrtsremotetrackdelegate\/rtsremotetrackactive(_:)","abstract":[{"type":"text","text":"Event received when the track, i.e. it’s publishing source, has become active."},{"type":"text","text":" "},{"type":"text","text":"In other words the stream is being sent to the server and is viable on the viewing"},{"type":"text","text":" "},{"type":"text","text":"client. The track is not enabled by default. The application can still call"},{"type":"text","text":" "},{"type":"text","text":"disable() on this track to prevent it from being played. If the track"},{"type":"text","text":" "},{"type":"text","text":"was previously disabled, the application must call enable() for the track"},{"type":"text","text":" "},{"type":"text","text":"to be renderable. If the track was previously enabled by the application and is not"},{"type":"text","text":" "},{"type":"text","text":"disabled by the application it will automatically start playing once it becomes"},{"type":"text","text":" "},{"type":"text","text":"active."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rtsRemoteTrackActive","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MCRTSRemoteTrack","preciseIdentifier":"c:objc(cs)MCRTSRemoteTrack","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic"},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrack/ActivityEvent":{"url":"\/documentation\/millicastsdk\/mcrtsremotetrack\/activityevent","abstract":[{"type":"text","text":"Track activity event"}],"type":"topic","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"ActivityEvent","kind":"identifier"}],"title":"MCRTSRemoteTrack.ActivityEvent","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityEvent","kind":"identifier"}],"identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrack\/ActivityEvent"},"doc://io.cosmosoftware.millicast.sdk/documentation/MillicastSDK/MCRTSRemoteTrackDelegate/rtsRemoteTrackInactive(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rtsRemoteTrackInactive"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)MCRTSRemoteTrack","text":"MCRTSRemoteTrack"},{"kind":"text","text":")"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrackDelegate\/rtsRemoteTrackInactive(_:)","role":"symbol","abstract":[{"text":"Event received when the track, i.e. it’s publishing source, has become inactive.","type":"text"},{"text":" ","type":"text"},{"text":"In other words the publishers stream is no longer being sent to the server and is","type":"text"},{"text":" ","type":"text"},{"text":"thus no longer viewable on the viewing client. The track is not disabled by the SDK","type":"text"},{"text":" ","type":"text"},{"text":"when this event occurs. If the application wants to ensure the track will not","type":"text"},{"text":" ","type":"text"},{"text":"automatically be played once the source becomes active it should call disable() when","type":"text"},{"text":" ","type":"text"},{"text":"receiving this event. Then it is responsible for calling enable() on the Active event.","type":"text"},{"text":" ","type":"text"},{"text":"If the application does not disable on Inactive event, the track will automatically start","type":"text"},{"text":" ","type":"text"},{"text":"playing when the remote source becomes Active.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"rtsRemoteTrackInactive:"}],"title":"rtsRemoteTrackInactive(_:)","url":"\/documentation\/millicastsdk\/mcrtsremotetrackdelegate\/rtsremotetrackinactive(_:)"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","value":"MCRTSRemoteTrack","path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrack\/title"},{"op":"replace","value":[{"kind":"identifier","text":"MCRTSRemoteTrack"}],"path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrack\/fragments"},{"op":"replace","value":"rtsRemoteTrackActive:","path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrackDelegate~1rtsRemoteTrackActive(_:)\/title"},{"op":"replace","value":[{"text":"- ","kind":"text"},{"text":"rtsRemoteTrackActive:","kind":"identifier"}],"path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrackDelegate~1rtsRemoteTrackActive(_:)\/fragments"},{"op":"replace","value":"rtsRemoteTrackInactive:","path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrackDelegate~1rtsRemoteTrackInactive(_:)\/title"},{"op":"replace","value":[{"kind":"text","text":"- "},{"kind":"identifier","text":"rtsRemoteTrackInactive:"}],"path":"\/references\/doc:~1~1io.cosmosoftware.millicast.sdk~1documentation~1MillicastSDK~1MCRTSRemoteTrackDelegate~1rtsRemoteTrackInactive(_:)\/fragments"}]}]}