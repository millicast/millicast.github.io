":"topic","role":"symbol","identifier":"doc:\/\/io.cosmosoftware.millicast.sdk\/documentation\/MillicastSDK\/MCRTSRemoteTrackDelegate\/rtsRemoteTrackInactive(_:)","abstract":[{"text":"Event received when the track, i.e. it’s publishing source, has become inactive.","type":"text"},{"text":" ","type":"text"},{"text":"In other words the publishers stream is no longer being sent to the server and is","type":"text"},{"text":" ","type":"text"},{"text":"thus no longer viewable on the viewing client. The track is not disabled by the SDK","type":"text"},{"text":" ","type":"text"},{"text":"when this event occurs. If the application wants to ensure the track will not","type":"text"},{"text":" ","type":"text"},{"text":"automatically be played once the source becomes active it should call disable() when","type":"text"},{"text":" ","type":"text"},{"text":"receiving this event. Then it is responsible for calling enable() on the Active event.","type":"text"},{"text":" ","type":"text"},{"text":"If the application does not disable on Inactive event, the track will automatically start","type":"text"},{"text":" ","type":"text"},{"text":"playing when the remote source becomes Active.","type":"text"}],"title":"rtsRemoteTrackInactive(_:)","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rtsRemoteTrackInactive"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)MCRTSRemoteTrack","text":"MCRTSRemoteTrack"},{"kind":"text","text":")"}],"url":"\/documentation\/millicastsdk\/mcrtsremotetrackdelegate\/rtsremotetrackinactive(_:)"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","path":"\/identifier\/interfaceLanguage","value":"occ"},{"op":"replace","path":"\/metadata\/roleHeading","value":"Protocol"},{"op":"replace","path":"\/metadata\/title","value":"MCRTSRemoteTrackDelegate"},{"op":"replace","path":"\/metadata\/symbolKind","value":"protocol"},{"op":"replace